  },

  "projectStructure": {
    "description": "Folder structure for Vanilla JavaScript project",
    "structure": {
      "root": {
        "index.html": "Patient portal home page",
        "public/": {
          "index.html": "Patient booking portal",
          "doctors-list.html": "Show doctors for selected specialty",
          "appointment-booking.html": "Calendar + slot selection",
