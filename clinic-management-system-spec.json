        "Use addEventListener() for event handling",
        "Use data-* attributes for storing data on HTML elements",
        "Avoid jQuery - pure JavaScript only"
      ],
      "stateManagement": [
        "Use plain JavaScript objects to store state",
        "Use localStorage for persistence (clinic settings, user preferences)",
        "Pass state through function parameters (functional approach)",
        "Use closure for module pattern (IIFE - Immediately Invoked Function Expression)"
      ],
      "asyncOperations": [
        "Use Fetch API for HTTP requests (no axios)",
        "Use async/await for cleaner asynchronous code",
        "Handle errors with try/catch",
        "Firebase operations are promise-based - use .then() or async/await"
      ],
      "templates": [
        "Use template literals (backticks) for HTML templates",
        "Example: `<div class='card'>${doctorName}</div>`",
        "Create functions that return HTML strings",
        "Use innerHTML to render templates into DOM"
      ],
      "modularity": [
        "Each feature in its own .js file (doctors.js, specialties.js, etc)",
        "Export functions using common.js patterns or ES6 modules",
        "Keep functions small and focused (single responsibility)",
        "Reuse utility functions from utils.js"
      ]
