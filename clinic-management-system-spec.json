{
  "projectName": "Clinic Management System",
  "projectVersion": "1.0.0",
  "projectDescription": "A comprehensive clinic management system with admin panel, patient portal, and reception dashboard. Fully customizable with clinic-specific branding, dynamic data management, and real-time notifications.",
  "createdBy": "Ahmed",
  "createdDate": "2026-07-24",
  
  "projectScope": {
    "overview": "Multi-doctor, multi-specialty clinic management platform",
    "deployment": "Web app (responsive for desktop + mobile browsers)",
    "customization": "All clinic data (name, logo, colors, specialties, doctors) configurable via admin settings",
    "dataSource": "Only real data entered by admin - zero dummy/hardcoded data"
  },

  "techStack": {
    "frontend": {
      "framework": "Vanilla JavaScript (No frameworks)",
      "language": "Plain HTML5 + CSS3 + JavaScript ES6+",
      "styling": "Custom CSS (responsive grid + flexbox)",
      "stateManagement": "Plain JavaScript objects + localStorage",
      "apiCalls": "Fetch API for HTTP requests",
      "templating": "Template literals (backticks) + DOM manipulation",
      "bundler": "Optional: Vite (for local development) OR plain static files",
      "responsiveness": "Mobile-first CSS media queries"
    },
    "backend": {
      "runtime": "Node.js + Express",
      "database": "Firebase Firestore (primary) + PostgreSQL (optional for complex queries)",
      "hosting": "Vercel for serverless functions / Railway for full backend",
      "authentication": "Firebase Auth"
    },
    "realtime": {
      "notifications": "Firebase Cloud Messaging (FCM) + In-app notifications",
      "messaging": "Firebase Realtime Database for live updates",
      "optional": "Twilio for optional SMS"
    },
    "payments": {
      "primary": "Paymob",
      "currency": "Egyptian Pound (EGP)"
    }
  },

  "databaseSchema": {
    "tables": {
      "clinics": {
        "description": "Clinic master data",
        "fields": {
          "id": "string (UUID, primary key)",
          "name": "string (clinic name - editable via admin)",
          "logo": "string (URL to uploaded logo image)",
          "description": "string (clinic description)",
          "address": "string",
          "phone": "string",
          "email": "string",
          "primaryColor": "string (hex color code for branding)",
          "secondaryColor": "string (hex color code for branding)",
          "workingDaysStart": "string (e.g., 'Saturday')",
          "workingDaysEnd": "string (e.g., 'Thursday')",
          "workingHoursStart": "string (e.g., '09:00')",
          "workingHoursEnd": "string (e.g., '17:00')",
          "timezone": "string (default: 'Africa/Cairo')",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      },

      "specialties": {
        "description": "Medical specialties offered by clinic",
        "fields": {
          "id": "string (UUID, primary key)",
          "clinicId": "string (foreign key → clinics)",
          "name": "string (e.g., 'أسنان', 'باطنة', 'أطفال')",
          "description": "string (optional)",
          "basePrice": "number (default price for this specialty)",
          "icon": "string (URL to specialty icon)",
          "displayOrder": "number (for sorting in UI)",
          "isActive": "boolean",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      },

      "doctors": {
        "description": "Doctors/practitioners",
        "fields": {
          "id": "string (UUID, primary key)",
          "clinicId": "string (foreign key → clinics)",
          "specialtyId": "string (foreign key → specialties)",
          "name": "string (doctor's full name)",
          "phone": "string",
          "email": "string",
          "profileImage": "string (URL to doctor's photo)",
          "bio": "string (short biography)",
          "qualifications": "array of strings (e.g., ['ماجستير أسنان', 'شهادة دولية'])",
          "workingHoursStart": "string (e.g., '09:00')",
          "workingHoursEnd": "string (e.g., '17:00')",
          "appointmentDuration": "number (in minutes: 30, 60)",
          "maxAppointmentsPerDay": "number",
          "daysOff": "array of strings (e.g., ['Friday', 'Sunday'])",
          "isActive": "boolean",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      },

      "availableSlots": {
        "description": "Available appointment time slots",
        "fields": {
          "id": "string (UUID, primary key)",
          "clinicId": "string (foreign key → clinics)",
          "doctorId": "string (foreign key → doctors)",
          "date": "string (YYYY-MM-DD format)",
          "startTime": "string (HH:mm format, e.g., '09:00')",
          "endTime": "string (HH:mm format, e.g., '09:30')",
          "isBooked": "boolean (default: false)",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        },
        "note": "Generated automatically based on doctor's working hours and appointment duration"
      },

      "appointments": {
        "description": "Patient appointment bookings",
        "fields": {
          "id": "string (UUID, primary key)",
          "clinicId": "string (foreign key → clinics)",
          "patientId": "string (foreign key → patients)",
          "doctorId": "string (foreign key → doctors)",
          "specialtyId": "string (foreign key → specialties)",
          "appointmentDate": "string (YYYY-MM-DD)",
          "appointmentTime": "string (HH:mm)",
          "slotId": "string (foreign key → availableSlots)",
          "status": "enum ('pending', 'confirmed', 'completed', 'cancelled', 'no-show')",
          "paymentStatus": "enum ('unpaid', 'paid', 'pending')",
          "paymentMethod": "enum ('paymob', 'cash', 'pending')",
          "price": "number (appointment price in EGP)",
          "notes": "string (patient notes/concerns)",
          "cancellationReason": "string (optional)",
          "paymentId": "string (Paymob transaction ID)",
          "reminderSMSSent": "boolean",
          "receiptSent": "boolean",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      },

      "patients": {
        "description": "Patient records",
        "fields": {
          "id": "string (UUID, primary key)",
          "clinicId": "string (foreign key → clinics)",
          "firstName": "string",
          "lastName": "string",
          "phone": "string",
          "email": "string",
          "dateOfBirth": "string (YYYY-MM-DD, optional)",
          "gender": "enum ('male', 'female', 'other', 'prefer_not_to_say')",
          "address": "string",
          "medicalHistory": "string (chronic diseases, allergies)",
          "emergencyContact": "string (phone number)",
          "preferredContactMethod": "enum ('phone', 'email', 'sms')",
          "notes": "string (internal clinic notes)",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      },

      "notifications": {
        "description": "Notification logs",
        "fields": {
          "id": "string (UUID, primary key)",
          "clinicId": "string (foreign key → clinics)",
          "patientId": "string (foreign key → patients)",
          "appointmentId": "string (foreign key → appointments, optional)",
          "type": "enum ('appointment_confirmed', 'appointment_reminder', 'appointment_cancelled', 'payment_received', 'custom')",
          "channel": "enum ('in_app', 'sms', 'email')",
          "title": "string",
          "message": "string",
          "status": "enum ('sent', 'failed', 'pending')",
          "sentAt": "timestamp",
          "readAt": "timestamp (optional, for in-app notifications)",
          "createdAt": "timestamp"
        }
      },

      "payments": {
        "description": "Payment transaction logs",
        "fields": {
          "id": "string (UUID, primary key)",
          "clinicId": "string (foreign key → clinics)",
          "appointmentId": "string (foreign key → appointments)",
          "patientId": "string (foreign key → patients)",
          "amount": "number (in EGP)",
          "currency": "string (default: 'EGP')",
          "paymentGateway": "string (default: 'paymob')",
          "transactionId": "string (Paymob transaction ID)",
          "status": "enum ('success', 'failed', 'pending', 'refunded')",
          "paymentMethod": "string (e.g., 'card', 'wallet')",
          "failureReason": "string (optional)",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      },

      "adminUsers": {
        "description": "Admin/staff accounts for clinic",
        "fields": {
          "id": "string (UUID, primary key)",
          "clinicId": "string (foreign key → clinics)",
          "email": "string (unique)",
          "name": "string",
          "role": "enum ('admin', 'receptionist', 'doctor', 'staff')",
          "phone": "string",
          "firebaseUid": "string (Firebase Auth UID)",
          "lastLogin": "timestamp",
          "isActive": "boolean",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      }
    }
  },

  "features": {
    "adminPanel": {
      "accessControl": "Email + Password login via Firebase Auth",
      "dashboard": {
        "widgets": [
          "Today's appointments count",
          "Total revenue today",
          "New patients this month",
          "Pending payments",
          "Recent appointments list"
        ]
      },
      "clinicSettings": {
        "description": "Editable clinic configuration",
        "sections": {
          "general": {
            "fields": [
              "Clinic name",
              "Logo upload (image)",
              "Description",
              "Address",
              "Phone number",
              "Email",
              "Primary color (color picker)",
              "Secondary color (color picker)"
            ]
          },
          "workingHours": {
            "fields": [
              "Working days (from-to)",
              "Working hours start time",
              "Working hours end time",
              "Timezone"
            ]
          }
        }
      },
      "specialtiesManagement": {
        "operations": [
          "Add specialty with name + description + base price + icon upload",
          "Edit specialty details",
          "Delete specialty (with confirmation)",
          "Reorder specialties (drag-drop)",
          "Toggle specialty active/inactive"
        ]
      },
      "doctorsManagement": {
        "operations": [
          "Add doctor: name + phone + email + select specialty + profile photo + bio + qualifications",
          "Set working hours (start-end time)",
          "Set appointment duration (30 min / 60 min / custom)",
          "Set max appointments per day",
          "Set days off (multi-select)",
          "Edit doctor information",
          "Delete doctor",
          "Toggle doctor active/inactive",
          "View doctor's appointments for today/week/month"
        ]
      },
      "appointmentsManagement": {
        "operations": [
          "View all appointments (filterable by date/doctor/status)",
          "Confirm pending appointments",
          "Mark appointment as completed",
          "Cancel appointment with reason",
          "Resend confirmation to patient",
          "View appointment details (patient info + notes)"
        ]
      },
      "patientsManagement": {
        "operations": [
          "View patient list",
          "Search patients by name/phone",
          "View patient profile (all appointments history)",
          "Edit patient notes",
          "Delete patient (with confirmation)",
          "View medical history"
        ]
      },
      "paymentsManagement": {
        "operations": [
          "View payment transactions (all/today/this month)",
          "Filter by status (paid/unpaid/failed)",
          "View payment details (patient + amount + date)",
          "Resend payment receipt",
          "View revenue reports by doctor/date"
        ]
      },
      "staffManagement": {
        "operations": [
          "Add receptionist/staff (email + name + role)",
          "Assign to clinic",
          "View staff list",
          "Reset staff password",
          "Deactivate staff account"
        ]
      },
      "reports": {
        "availableReports": [
          "Appointments report (by date/doctor/specialty)",
          "Revenue report (daily/monthly/by doctor)",
          "Patient statistics (new patients, total patients)",
          "Doctor performance (appointments count, revenue)",
          "Payment status report (pending/failed/successful)"
        ],
        "export": "CSV export for all reports"
      }
    },

    "patientPortal": {
      "accessFlow": "No login required initially (anonymous booking) OR optional patient account",
      "bookingFlow": [
        "1. Select specialty from clinic's available specialties",
        "2. View doctors in selected specialty",
        "3. Select doctor (see doctor's name, photo, qualifications)",
        "4. View available appointment slots (calendar view with date + time)",
        "5. Select preferred slot",
        "6. Enter patient info: name, phone, email, DOB, gender, address (prefilled if logged in)",
        "7. Add appointment notes (optional)",
        "8. Choose payment method: Online (Paymob) OR Pay on Arrival",
        "9. If online: Paymob payment gateway integration",
        "10. Confirmation page: Appointment details + booking reference number",
        "11. SMS notification: 'Booking confirmed. Appointment: [date] [time] with [doctor]'",
        "12. In-app notification (if have app account)"
      ],
      "paymentOptions": [
        "Online payment via Paymob",
        "Pay on arrival (cash at clinic)"
      ],
      "patientAccount": {
        "optional": true,
        "benefits": [
          "View all past/upcoming appointments",
          "Modify appointment (reschedule/cancel)",
          "View medical history notes",
          "Save favorite doctors",
          "Appointment reminders"
        ],
        "authentication": "Firebase Auth (email + password OR Google/Facebook)"
      },
      "appointmentReminder": "Notification 30 minutes before appointment: 'Your appointment is in 30 minutes. Doctor: [name]'",
      "uiElements": {
        "responsive": "Mobile-first design",
        "colorScheme": "Uses clinic's primary + secondary colors from admin settings",
        "logo": "Displays clinic logo at top",
        "doctorCard": [
          "Doctor photo",
          "Doctor name",
          "Specialty",
          "Qualifications",
          "Average rating (if review system added later)"
        ],
        "calendarView": "Shows available dates in next 30 days"
      }
    },

    "receptionDashboard": {
      "accessControl": "Login as receptionist (email + password via Firebase Auth)",
      "mainView": [
        "Filter by doctor (dropdown to select which doctor's appointments to view)",
        "Display today's appointments in chronological order",
        "For each appointment, show:",
        "  - Patient name",
        "  - Appointment time",
        "  - Patient phone number",
        "  - Status badge (pending/confirmed/arrived/completed)",
        "  - [Call Patient] button (blue button with bell icon)"
      ],
      "callPatientButton": {
        "action": "When clicked, send notification to patient",
        "notification": "In-app alert: 'You're called! Please come to room [number] or reception area.'",
        "optional": "SMS: 'You're being called at [clinic name]. Please come in.'",
        "sound": "Notification sound on patient's app",
        "dismissal": "Patient can dismiss notification after 1 minute"
      },
      "appointmentStatusFlow": [
        "pending → (click 'Confirm') → confirmed",
        "confirmed → (patient arrives, click 'Mark as Arrived') → arrived",
        "arrived → (after appointment, click 'Complete') → completed",
        "Any status → (click 'Cancel') → cancelled"
      ],
      "viewOptions": [
        "Today's appointments (default)",
        "This week's appointments",
        "All pending appointments",
        "Appointments by doctor (multi-select)"
      ],
      "refreshRate": "Auto-refresh every 10 seconds OR real-time via WebSocket"
    },

    "paymobIntegration": {
      "flowType": "Hosted iframe or payment link",
      "integration": [
        "Patient selects online payment",
        "Amount calculated: appointment price + optional SMS fee",
        "Redirect to Paymob payment page",
        "After successful payment, return to confirmation page",
        "Store transaction ID in appointments table",
        "Update payment_status to 'paid' in Firebase"
      ],
      "failureHandling": "If payment fails, allow retry OR option to pay on arrival",
      "receiptGeneration": "After successful payment, generate PDF receipt with: appointment details, payment amount, transaction ID, clinic info",
      "webhookIntegration": "Paymob webhook to confirm payment in backend"
    },

    "notificationsSystem": {
      "channels": [
        "In-app notifications (Firebase Cloud Messaging - FCM)",
        "Optional SMS (Twilio - paid add-on)"
      ],
      "triggers": [
        {
          "event": "Appointment booked",
          "message": "Booking confirmed. Appointment: [date] [time] with Dr. [name]",
          "channels": ["in_app", "optional_sms"]
        },
        {
          "event": "Appointment reminder",
          "message": "Reminder: Your appointment is in 30 minutes with Dr. [name]",
          "channels": ["in_app", "optional_sms"],
          "timing": "30 minutes before appointment"
        },
        {
          "event": "Receptionist calls patient",
          "message": "You're called! Please come in.",
          "channels": ["in_app"],
          "sound": "notification sound"
        },
        {
          "event": "Appointment cancelled",
          "message": "Your appointment with Dr. [name] on [date] has been cancelled",
          "channels": ["in_app", "optional_sms"]
        },
        {
          "event": "Payment received",
          "message": "Payment received for your appointment on [date]. Thank you!",
          "channels": ["in_app"]
        }
      ],
      "inAppNotifications": {
        "storage": "Stored in 'notifications' table in Firestore",
        "display": "Badge on patient app + notification center",
        "persistence": "Stored until user deletes or 30 days passed"
      },
      "smsNotifications": {
        "provider": "Twilio",
        "cost": "2-3 EGP per SMS (pass cost to patient at checkout if opted-in)",
        "optional": "Patient can enable/disable SMS during booking"
      }
    },

    "realTimeUpdates": {
      "technology": "Firebase Realtime Database OR WebSockets",
      "updates": [
        "Reception dashboard auto-updates when new appointment is booked",
        "Appointment status changes sync in real-time",
        "Patient sees confirmation instantly after payment",
        "Admin sees new appointments without manual refresh"
      ]
    }
  },

