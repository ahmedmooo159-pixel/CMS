    "formHandling": {
      "filename": "js/auth.js",
      "description": "Handle login form submission",
      "pseudocode": [
        "document.getElementById('loginForm').addEventListener('submit', async (e) => {",
        "  e.preventDefault()",
        "  const email = document.getElementById('email').value",
        "  const password = document.getElementById('password').value",
        "  try {",
        "    const result = await auth.signInWithEmailAndPassword(email, password)",
        "    window.location.href = '/admin/dashboard.html'",
        "  } catch (error) {",
        "    console.error('Login failed:', error.message)",
        "    alert('Login failed: ' + error.message)",
        "  }",
        "})"
      ]
    },
    "firebaseDataFetch": {
      "filename": "js/dashboard.js",
      "description": "Fetch data from Firestore and render",
      "pseudocode": [
        "async function loadDoctors() {",
        "  const snapshot = await db.collection('doctors').get()",
        "  snapshot.forEach(doc => {",
        "    const doctor = doc.data()",
        "    const html = `<div class='doctor-card'>${doctor.name}</div>`",
        "    document.getElementById('doctorsList').innerHTML += html",
        "  })",
        "}",
        "loadDoctors()"
      ]
    },
    "domManipulation": {
      "filename": "js/utils.js",
      "description": "Common DOM manipulation utilities",
      "pseudocode": [
        "function renderElement(selector, content) {",
        "  document.querySelector(selector).innerHTML = content",
        "}",
        "function addEventListener(selector, event, callback) {",
        "  document.addEventListener(event, callback)",
        "}",
        "function getFormData(formId) {",
        "  const formElement = document.getElementById(formId)",
        "  return new FormData(formElement)",
        "}"
      ]
    }
