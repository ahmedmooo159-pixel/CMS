        "Set up Firebase SDK (CDN link in HTML)",
        "Initialize Firebase project (Firestore + Auth + FCM)",
        "Create Firestore collection schema",
        "Build admin login page (HTML form + CSS styling)",
        "Write login.js (Firebase Auth email/password)",
        "Build admin dashboard HTML template",
        "Create dashboard.js (fetch data from Firestore, render widgets)",
        "Write common.js (shared utilities, Firebase initialization)",
        "Responsive CSS for mobile + desktop",
        "Local testing with live server"
      ]
    },
    "sprint2": {
      "name": "Admin Settings - Clinic Configuration",
      "duration": "1 week",
      "tasks": [
        "Create settings.html page",
