rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── isAdmin: any authenticated Firebase user is treated as admin.
    // The public portal never signs users in, so only admins who logged in
    // via the admin login page will have request.auth != null.
    // NOTE: When Firebase Custom Claims are configured (role:'admin'),
    // you can tighten this back to:
    //   request.auth.token.role == 'admin' || request.auth.token.admin == true
    function isAdmin() {
      return request.auth != null;
    }
    
    // Default rule: Admin has full access to everything
    match /{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Public read access for read-only entities
    match /clinics/{document=**} {
      allow read: if true;
    }
    match /specialties/{document=**} {
      allow read: if true;
    }
    match /doctors/{document=**} {
      allow read: if true;
    }
    
    // Slots: Public can read. They can only update 'isBooked' or 'status' fields.
    match /availableSlots/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBooked', 'status', 'updatedAt']);
    }
    
    // Patients: Public can create an account and read for deduplication
    // (Notice: 'allow write' was removed to prevent unauthorized deletion/modification)
    match /patients/{document=**} {
      allow read: if true; 
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    // Appointments: Public can create, and can update status to 'cancelled' only (self-cancellation).
    match /appointments/{document=**} {
      allow create: if true;
      allow read: if true;
      // Allow patient self-cancellation: only 'status', 'updatedAt', and 'cancelledBy' fields can change
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'updatedAt', 'cancelledBy'])
                    && request.resource.data.status == 'cancelled';
      allow delete: if isAdmin();
    }
    
    // Inquiries (contact form): Public can only create, admins manage.
    match /inquiries/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
