rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is admin
    function isAdmin() {
      return request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }
    
    // Default rule: Admin has full access to everything
    match /{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Public read access for specific collections needed for booking
    match /clinics/{document=**} {
      allow read: if true;
    }
    match /specialties/{document=**} {
      allow read: if true;
    }
    match /doctors/{document=**} {
      allow read: if true;
    }
    match /availableSlots/{document=**} {
      allow read: if true;
      allow update: if true; // Needed to mark a slot as booked
    }
    
    // Allow public to create patients and appointments
    match /patients/{document=**} {
      allow read: if true; // Depending on requirements, might be needed for deduplication query
      allow write: if true;
    }
    
    match /appointments/{document=**} {
      allow create: if true;
      allow read: if true; // if user wants to see their appointment
    }
  }
}

